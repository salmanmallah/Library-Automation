# ====================================================================
# Institutional Library Automation Platform — Environment Configuration
# ====================================================================

# Institution Branding
INSTITUTION_NAME="MUET Central Library & Information Center"

# Database Configuration
# Local SQLite Default:
DATABASE_URL="sqlite:///./library_catalog.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql://library_admin:LibrarySecurePass2026@localhost:5432/library_db"

# Security & Authentication
JWT_SECRET_KEY="replace-with-a-strong-random-secret-for-production-deployment-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Circulation Policy & Business Rules
DEFAULT_LOAN_DAYS=14
FINE_PER_DAY=1.0
MAX_LOANS_PER_MEMBER=5
MAX_RENEWALS_PER_LOAN=2
RESERVATION_EXPIRY_DAYS=3

# Camera / Vision Source
# Android IP Webcam over ADB USB: http://127.0.0.1:8080/video
# USB Webcam: 0 or 1
CAMERA_INDEX="http://127.0.0.1:8080/video"
COOLDOWN_SECONDS=3.0
WORKER_THREADS=4

# Server Networking
HOST="127.0.0.1"
PORT=8000
DEBUG=false
